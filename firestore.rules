rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow users to create and read their own copilot sessions.
    // They cannot update or delete them through the client.
    match /users/{userId}/copilotSessions/{sessionId} {
      allow read, create: if request.auth != null && request.auth.uid == userId;
    }
  }
}
