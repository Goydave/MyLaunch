
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Allow users to manage their own copilot sessions
    match /users/{userId}/copilotSessions/{sessionId} {
      allow create, read: if request.auth != null && request.auth.uid == userId;
    }
    
    match /users/{userId}/copilotSessions/{sessionId}/{document=**} {
       allow read, create: if request.auth != null && request.auth.uid == userId;
    }

    // Allow users to list their own copilot sessions
     match /users/{userId}/copilotSessions {
      allow list: if request.auth != null && request.auth.uid == userId;
    }
  }
}
